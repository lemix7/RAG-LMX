# --- Backend (FastAPI) ---

# OpenAI API key for embeddings, the chat model, and Whisper transcription
OPENAI_API_KEY=sk-...

# Supabase project URL — used to fetch the JWKS and verify ES256 JWT tokens.
# Find it in your Supabase project: Settings → API → Project URL.
SUPABASE_URL=https://xxxx.supabase.co

# Only needed for legacy projects still using HS256 (JWT Signing Keys → Legacy JWT Secret).
# Leave blank if your project uses the newer ES256 JWT Signing Keys (most projects after 2024).
SUPABASE_JWT_SECRET=

# Shared secret for admin-only, system-wide backend endpoints (e.g. aggregate
# document stats for the admin dashboard). Must match ADMIN_API_SECRET in the
# frontend. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_SECRET=

# --- Voice (optional) ---
# ElevenLabs powers text-to-speech. When unset, the app runs text-only and /tts
# returns a clear error. Whisper (speech-to-text) reuses OPENAI_API_KEY above.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
